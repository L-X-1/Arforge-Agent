        ],
        "negative_path": [
          ["{venv_ctest}", "--test-dir", "build", "-L", "negative", "--output-on-failure"]
        ],
        "release_artifact": [
          ["{venv_cmake}", "--build", "build", "--target", "package"]
        ],
        "repeatability": [
          ["{venv_ctest}", "--test-dir", "build", "--output-on-failure"],
          ["{venv_ctest}", "--test-dir", "build", "--output-on-failure"]
