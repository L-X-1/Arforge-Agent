        ],
        "unit_tests": [
          ["docker", "run", "--rm", "-v", "{workspace}:/workspace", "-v", "arforge-project-gradle-cache:/home/gradle/.gradle", "-w", "/workspace", "gradle:8.14-jdk21-alpine", "gradle", "test", "--tests", "*PolicyUnitTest", "--no-daemon"]
        ],
        "integration_tests": [
          ["docker", "run", "--rm", "-v", "{workspace}:/workspace", "-v", "arforge-project-gradle-cache:/home/gradle/.gradle", "-w", "/workspace", "gradle:8.14-jdk21-alpine", "gradle", "test", "--tests", "*RepositoryIntegrationTest", "--no-daemon"]
        ],
        "negative_path": [
          ["docker", "run", "--rm", "-v", "{workspace}:/workspace", "-v", "arforge-project-gradle-cache:/home/gradle/.gradle", "-w", "/workspace", "gradle:8.14-jdk21-alpine", "gradle", "test", "--tests", "*PolicyNegativeTest", "--no-daemon"]
        ],
        "release_artifact": [
          ["docker", "run", "--rm", "-v", "{workspace}:/workspace", "-v", "arforge-project-gradle-cache:/home/gradle/.gradle", "-w", "/workspace", "gradle:8.14-jdk21-alpine", "gradle", "jar", "--no-daemon"]
        ],
        "repeatability": [
          ["docker", "run", "--rm", "-v", "{workspace}:/workspace", "-v", "arforge-project-gradle-cache:/home/gradle/.gradle", "-w", "/workspace", "gradle:8.14-jdk21-alpine", "gradle", "test", "--no-daemon"],
          ["docker", "run", "--rm", "-v", "{workspace}:/workspace", "-v", "arforge-project-gradle-cache:/home/gradle/.gradle", "-w", "/workspace", "gradle:8.14-jdk21-alpine", "gradle", "test", "--no-daemon"]
        ]
      }
