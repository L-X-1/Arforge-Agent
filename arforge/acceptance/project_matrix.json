{
  "schema_version": 1,
  "required_phases": [
    "clean_build",
    "unit_tests",
    "integration_tests",
    "negative_path",
    "release_artifact",
    "repeatability"
  ],
  "projects": [
    {
      "id": "python-service",
      "template": "python_service",
      "capabilities": [
        "lang-python",
        "framework-fastapi",
        "db-sqlite",
        "tool-pip",
        "test-pytest"
      ],
      "minimum_files": 7,
      "artifact_glob": "dist/*.whl",
      "environment": {
        "PYTHONPATH": "src"
      },
      "phases": {
        "clean_build": [
          ["{python}", "-m", "compileall", "-q", "src"]
        ],
        "unit_tests": [
          ["{python}", "-m", "pytest", "tests/unit", "-q"]
        ],
        "integration_tests": [
          ["{python}", "-m", "pytest", "tests/integration", "-q"]
        ],
        "negative_path": [
          ["{python}", "-m", "pytest", "tests/negative", "-q"]
        ],
        "release_artifact": [
          ["{python}", "-m", "pip", "wheel", ".", "--no-deps", "--no-build-isolation", "-w", "dist"]
        ],
        "repeatability": [
          ["{python}", "-m", "pytest", "-q"],
          ["{python}", "-m", "pytest", "-q"]
        ]
      }
    },
    {
      "id": "node-web-platform",
      "template": "node_web_platform",
      "capabilities": [
        "lang-javascript",
        "lang-typescript",
        "framework-node",
        "framework-express",
        "framework-vue",
        "framework-react",
        "tool-npm",
        "tool-pnpm",
        "test-jest"
      ],
      "minimum_files": 8,
      "artifact_glob": "dist/*.tgz",
      "environment": {
        "CI": "1"
      },
      "phases": {
        "clean_build": [
          ["pnpm", "install", "--no-frozen-lockfile", "--ignore-scripts"],
          ["npm", "run", "build", "--silent"]
        ],
        "unit_tests": [
          ["npm", "test", "--", "--runInBand", "tests/unit"]
        ],
        "integration_tests": [
          ["npm", "test", "--", "--runInBand", "tests/integration"]
        ],
        "negative_path": [
          ["npm", "test", "--", "--runInBand", "tests/negative"]
        ],
        "release_artifact": [
          ["node", "-e", "require('fs').mkdirSync('dist',{recursive:true})"],
          ["npm", "pack", "--pack-destination", "dist"]
        ],
        "repeatability": [
          ["npm", "test", "--", "--runInBand"],
          ["npm", "test", "--", "--runInBand"]
        ]
      }
    },
    {
      "id": "spring-service",
      "template": "spring_service",
      "capabilities": [
        "lang-java",
        "framework-spring",
        "tool-maven",
        "test-junit"
      ],
      "minimum_files": 8,
      "artifact_glob": "target/*.jar",
      "environment": {
        "MAVEN_OPTS": "-Dfile.encoding=UTF-8"
      },
      "phases": {
        "clean_build": [
          ["mvn", "-q", "-DskipTests", "clean", "package"]
        ],
        "unit_tests": [
          ["mvn", "-q", "-Dtest=WorkServiceTest", "test"]
        ],
        "integration_tests": [
          ["mvn", "-q", "-Dtest=WorkControllerIntegrationTest", "test"]
        ],
        "negative_path": [
          ["mvn", "-q", "-Dtest=WorkControllerNegativeTest", "test"]
        ],
        "release_artifact": [
          ["mvn", "-q", "-DskipTests", "package"]
        ],
        "repeatability": [
          ["mvn", "-q", "test"],
          ["mvn", "-q", "test"]
        ]
      }
    },
    {
