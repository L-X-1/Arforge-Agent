    "E:/Arforge"
  ],
  "excludeDirectories": [
    ".arforge",
    ".arforge-acceptance-workspaces",
    ".arforge-bridge-smoke",
    ".arforge-run",
    ".arforge-worktrees",
    ".codex-doc-review",
    ".git",
    ".mypy_cache",
    ".pytest-tmp",
    ".pytest_cache",
    ".recovery_pyc",
    ".ruff_cache",
    ".tmp",
    ".tools",
    ".turbo",
    ".venv",
    "arforge_agent.egg-info",
    "artifacts",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "out",
    "target",
    "tmp",
    "venv",
    "workspace"
  ],
  "externalReferenceDocumentation": [
    "README.md",
    "README.cn.md",
    "docs/DELETE_CANDIDATES_2026-07-27.md",
