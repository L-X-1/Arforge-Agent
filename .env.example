# Copy to ~/.arforge/.env and replace placeholders locally.
# Never commit real secrets or production database URLs.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
# Desktop/local release: set local and omit both database URLs.
# Team/server release: set server and configure both PostgreSQL URLs.
ARFORGE_DATABASE_MODE=server
ARFORGE_DB_URL=postgresql://arforge:replace-password@127.0.0.1:5432/arforge
ARFORGE_MULTIAGENT_DB_URL=postgresql://arforge:replace-password@127.0.0.1:5432/arforge_multiagent
# ARFORGE_SQLITE_BUSY_TIMEOUT_MS=15000
ARFORGE_MULTIAGENT_TOTAL_TIMEOUT=300
# Mandatory per-task hard budget used by the default model eval runner.
ARFORGE_EVAL_TOKEN_BUDGET=300000

# Production multi-user authentication (requires PostgreSQL and HTTPS).
# Generate ARFORGE_AUTH_SECRET from at least 32 cryptographically random bytes;
# do not reuse the database password or an API key.
# ARFORGE_AUTH_MODE=users
# ARFORGE_AUTH_SECRET=replace-with-at-least-32-random-characters
# ARFORGE_PUBLIC_URL=https://arforge.example.com
# ARFORGE_AUTH_EMAIL_WEBHOOK_URL=https://mailer.example.com/arforge-auth
# ARFORGE_AUTH_EMAIL_WEBHOOK_TOKEN=replace-with-a-webhook-bearer-token
# Set only when a trusted reverse proxy controls X-Forwarded-For.
# ARFORGE_TRUST_PROXY=true
# Loopback development only. Startup rejects this on a public host.
# ARFORGE_AUTH_EXPOSE_TOKENS=false

# Private builds never contact a public update service unless this is explicitly set.
# ARFORGE_UPDATE_METADATA_URL=https://your-private-host/arforge.json
# Emergency kill switch for run-scoped deferred tool schemas (enabled by default).
ARFORGE_FEATURE_DEFERRED_TOOL_LOADING=1

# Optional raw-model HTTP proxy. It is disabled by default and is not the
# workspace agent runtime. Set a random token with at least 32 characters.
# ARFORGE_ENABLE_HTTP_API=0
# ARFORGE_ENABLE_RAW_MODEL_API=0
# ARFORGE_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# ARFORGE_API_CORS_ORIGINS=http://127.0.0.1:3000

# Optional authenticated Web control client. Loopback launches generate an
# ephemeral token when this is omitted. Remote binding requires both settings.
# ARFORGE_WEB_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# ARFORGE_ALLOW_REMOTE_WEB=0

# Optional native HTTPS listener. Both PEM paths are required together.
# ARFORGE_HTTPS_CERT=E:/secure/arforge-private.crt
# ARFORGE_HTTPS_KEY=E:/secure/arforge-private.key

# Optional: isolate local state in automation.
# ARFORGE_HOME=/path/to/isolated/arforge-home

# Optional: canonical workspace used by Desktop path-confined actions.
# ARFORGE_WORKSPACE=/path/to/project

# Optional: directory containing pg_dump and pg_restore.
# ARFORGE_PG_BIN=/path/to/postgresql/bin

# DANGEROUS: only enable both in an isolated, trusted automation workspace.
# ARFORGE_AUTO_APPROVE=0
# ARFORGE_TRUST_WORKSPACE=0
