---
import BrandMark from "../components/BrandMark.astro"
import "../styles/global.css"
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Arforge — 本地优先的 AI 开发智能体"/><link rel="canonical" href="https://arforgeagent.com/"/><link rel="alternate" hreflang="zh-CN" href="https://arforgeagent.com/zh-CN/"/><link rel="alternate" hreflang="en" href="https://arforgeagent.com/en/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>Arforge — Local-first AI development agent</title></head><body><main class="locale-gate"><BrandMark/><div><p class="eyebrow">Choose your language · 选择语言</p><h1>把开发目标，推进到可验证的交付。</h1><p>Carry development goals through to verified delivery.</p><div class="hero__actions"><a class="button" href="/zh-CN/">简体中文</a><a class="button button--secondary" href="/en/">English</a></div></div></main><style>.locale-gate{width:var(--container);min-height:100vh;margin:0 auto;padding:30px 0;display:grid;grid-template-rows:auto 1fr;gap:80px}.locale-gate>div{align-self:center;padding-bottom:12vh}.locale-gate h1{max-width:1000px;margin:0;font-size:clamp(50px,7vw,100px);font-weight:550;line-height:1;letter-spacing:-.06em}.locale-gate p:not(.eyebrow){color:var(--site-muted);font-size:clamp(20px,2vw,28px)}@media(max-width:767px){.locale-gate .hero__actions{display:grid}}</style><script is:inline>try{const saved=localStorage.getItem("arforge-locale");if(saved==="zh-CN"||saved==="en")document.documentElement.dataset.suggestedLocale=saved}catch{}</script></body></html>
