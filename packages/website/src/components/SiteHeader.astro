---
import BrandMark from "./BrandMark.astro"
import { alternateLocale, siteCopy, type Locale, type PublicPage } from "../content"

interface Props { locale: Locale; page?: PublicPage | "home" }
const { locale, page = "home" } = Astro.props
const copy = siteCopy[locale]
const alternate = alternateLocale(locale)
const pagePath = page === "home" ? "" : page
const base = `/${locale}`
const alternateHref = `/${alternate}/${pagePath}`
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href={`${base}/`} aria-label="Arforge home"><BrandMark /></a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <a aria-current={page === "product" ? "page" : undefined} href={`${base}/product/`}>{copy.nav.product}</a>
      <a aria-current={page === "docs" ? "page" : undefined} href={`${base}/docs/`}>{copy.nav.docs}</a>
      <a aria-current={page === "download" ? "page" : undefined} href={`${base}/download/`}>{copy.nav.download}</a>
      <a aria-current={page === "changelog" ? "page" : undefined} href={`${base}/changelog/`}>{copy.nav.changelog}</a>
    </nav>
    <div class="site-header__actions">
      <a class="language-link" href={alternateHref} hreflang={alternate}>{siteCopy[alternate].language}</a>
      <a class="text-link site-header__login" href={`/login/?lang=${locale}`}>{copy.nav.login}</a>
      <a class="button button--small" href={`${base}/download/`}>{copy.downloadWindows}</a>
      <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav aria-label="Mobile navigation">
      <a href={`${base}/product/`}>{copy.nav.product}</a>
      <a href={`${base}/docs/`}>{copy.nav.docs}</a>
      <a href={`${base}/download/`}>{copy.nav.download}</a>
      <a href={`${base}/changelog/`}>{copy.nav.changelog}</a>
      <a href={`/login/?lang=${locale}`}>{copy.nav.login}</a>
      <a href={alternateHref} hreflang={alternate}>{siteCopy[alternate].language}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]")
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]")
  if (header && button && menu) {
    const close = () => {
      button.setAttribute("aria-expanded", "false")
      button.setAttribute("aria-label", "Open menu")
      menu.hidden = true
      document.documentElement.classList.remove("menu-open")
    }
    const open = () => {
      button.setAttribute("aria-expanded", "true")
      button.setAttribute("aria-label", "Close menu")
      menu.hidden = false
      document.documentElement.classList.add("menu-open")
      menu.querySelector<HTMLAnchorElement>("a")?.focus()
    }
    button.addEventListener("click", () => button.getAttribute("aria-expanded") === "true" ? close() : open())
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) { close(); button.focus() }
    })
    menu.addEventListener("click", (event) => { if ((event.target as Element).closest("a")) close() })
  }
</script>
