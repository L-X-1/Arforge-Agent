---
import BrandMark from "./BrandMark.astro"
import { alternateLocale, siteCopy, type Locale } from "../content"
interface Props { locale: Locale }
const { locale } = Astro.props
const copy = siteCopy[locale]
const alternate = alternateLocale(locale)
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div><BrandMark /><p>{copy.footerNote}</p></div>
    <nav aria-label="Footer navigation">
      <a href={`/${locale}/product/`}>{copy.nav.product}</a>
      <a href={`/${locale}/docs/`}>{copy.nav.docs}</a>
      <a href={`/${locale}/download/`}>{copy.nav.download}</a>
      <a href={`/${locale}/changelog/`}>{copy.nav.changelog}</a>
      <a href={`/${locale}/privacy/`}>{copy.legal.privacy}</a>
      <a href={`/${locale}/terms/`}>{copy.legal.terms}</a>
    </nav>
  </div>
  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} Arforge</span>
    <a href={`/${alternate}/`} hreflang={alternate}>{siteCopy[alternate].language}</a>
    <span class="status"><span aria-hidden="true"></span>{copy.beta}</span>
  </div>
</footer>
