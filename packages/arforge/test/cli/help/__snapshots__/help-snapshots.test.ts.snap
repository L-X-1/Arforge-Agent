      --print-logs     将日志输出到标准错误                                                   [布尔]
      --log-level      日志级别                 [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure           不加载外部插件                                                         [布尔]
      --title          任务标题                                                             [字符串]
      --description    任务描述                                                             [字符串]
      --active-form    进行中显示文本                                                       [字符串]
      --owner          任务所有者，领取和释放时必需                                         [字符串]
      --status         列表状态过滤    [可选值： "pending", "in_progress", "completed", "cancelled"]
      --search         列表关键词过滤                                                       [字符串]
      --blocked-by     依赖任务 ID，逗号分隔                                                [字符串]
      --blocks         被本任务阻塞的任务 ID，逗号分隔                                      [字符串]
      --metadata       字符串值 JSON 对象                                                   [字符串]
      --revision       可选乐观锁版本；省略时自动读取最新版本                                 [数字]
      --terminal-only  clear 仅清理已结束任务                                 [布尔] [默认值： true]
      --workspace      会话所属工作区，默认为当前目录                                       [字符串]
      --json           输出机器可读 JSON                                     [布尔] [默认值： false]"
`;

