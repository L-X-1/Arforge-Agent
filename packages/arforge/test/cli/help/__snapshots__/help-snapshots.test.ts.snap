// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`arforge CLI help-text snapshots every documented command emits stable help text: arforge acp --help 1`] = `
"arforge acp

启动 ACP（代理客户端协议）服务器

选项：
  -h, --help         显示帮助                                                                 [布尔]
  -v, --version      显示版本号                                                               [布尔]
      --print-logs   将日志输出到标准错误                                                     [布尔]
      --log-level    日志级别                   [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         不加载外部插件                                                           [布尔]
      --port         监听端口                                                    [数字] [默认值： 0]
      --hostname     监听主机名                                      [字符串] [默认值： "127.0.0.1"]
      --mdns         启用 mDNS 服务发现（主机名默认改为 0.0.0.0）            [布尔] [默认值： false]
      --mdns-domain  mDNS 自定义域名（默认：arforge.local）      [字符串] [默认值： "arforge.local"]
      --cors         额外允许跨域访问的域名                                     [数组] [默认值： []]
      --https-cert   HTTPS PEM 证书文件（需同时提供 --https-key）                           [字符串]
      --https-key    HTTPS PEM 私钥文件（需同时提供 --https-cert）                          [字符串]
      --cwd          working directory
                               [字符串] [默认值： "<HOME>"]"
`;

exports[`arforge CLI help-text snapshots every documented command emits stable help text: arforge mcp --help 1`] = `
"arforge mcp

管理 MCP（模型上下文协议）服务器

命令：
  arforge mcp add [name]     add an MCP server
  arforge mcp list           list MCP servers and their status [aliases: ls]
  arforge mcp auth [name]    authenticate with an OAuth-enabled MCP server
  arforge mcp logout [name]  remove OAuth credentials for an MCP server
  arforge mcp debug <name>   debug OAuth connection for an MCP server

选项：
  -h, --help        显示帮助                                                                  [布尔]
  -v, --version     显示版本号                                                                [布尔]
      --print-logs  将日志输出到标准错误                                                      [布尔]
      --log-level   日志级别                    [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        不加载外部插件                                                            [布尔]"
`;

exports[`arforge CLI help-text snapshots every documented command emits stable help text: arforge attach --help 1`] = `
"arforge attach <url>

连接正在运行的 Arforge 服务器

位置参数：
  url  http://localhost:4096                                                         [字符串] [必需]

选项：
  -h, --help          显示帮助                                                                [布尔]
  -v, --version       显示版本号                                                              [布尔]
      --print-logs    将日志输出到标准错误                                                    [布尔]
      --log-level     日志级别                  [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          不加载外部插件                                                          [布尔]
      --dir           directory to run in                                                   [字符串]
  -c, --continue      continue the last session                                               [布尔]
  -s, --session       session id to continue                                                [字符串]
      --fork          fork the session when continuing (use with --continue or --session)     [布尔]
  -p, --password      basic auth password (defaults to ARFORGE_SERVER_PASSWORD)             [字符串]
  -u, --username      basic auth username (defaults to ARFORGE_SERVER_USERNAME or 'arforge')[字符串]
      --mini          start the minimal interactive interface                [布尔] [默认值： false]
      --no-replay     disable mini session history replay on resume and after resize          [布尔]
      --replay-limit  cap visible mini replay to the newest N messages                        [数字]"
`;

exports[`arforge CLI help-text snapshots every documented command emits stable help text: arforge run --help 1`] = `
"arforge run [message..]

使用消息运行 Arforge

位置参数：
  message  message to send                                                      [数组] [默认值： []]

选项：
  -h, --help         显示帮助                                                                 [布尔]
  -v, --version      显示版本号                                                               [布尔]
      --print-logs   将日志输出到标准错误                                                     [布尔]
      --log-level    日志级别                   [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         不加载外部插件                                                           [布尔]
      --command      the command to run, use message for args                               [字符串]
  -c, --continue     continue the last session                                                [布尔]
  -s, --session      session id to continue                                                 [字符串]
      --fork         fork the session before continuing (requires --continue or --session)    [布尔]
      --share        share the session                                                        [布尔]
  -m, --model        model to use in the format of provider/model                           [字符串]
      --agent        agent to use                                                           [字符串]
      --format       format: default (formatted) or json (raw JSON events)
                                          [字符串] [可选值： "default", "json"] [默认值： "default"]
  -f, --file         file(s) to attach to message                                             [数组]
      --title        title for the session (uses truncated prompt if no value provided)     [字符串]
      --attach       attach to a running Arforge server (e.g., http://localhost:4096)       [字符串]
  -p, --password     basic auth password (defaults to ARFORGE_SERVER_PASSWORD)              [字符串]
  -u, --username     basic auth username (defaults to ARFORGE_SERVER_USERNAME or 'arforge') [字符串]
      --dir          directory to run in, path on remote server if attaching                [字符串]
      --port         port for the local server (defaults to random port if no value provided) [数字]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [字符串]
      --thinking     show thinking blocks                                                     [布尔]
  -i, --interactive  run in direct interactive split-footer mode             [布尔] [默认值： false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                             [布尔] [默认值： false]"
`;

exports[`arforge CLI help-text snapshots every documented command emits stable help text: arforge debug --help 1`] = `
"arforge debug

调试和故障排查工具

命令：
  arforge debug config        show resolved configuration
  arforge debug lsp           LSP debugging utilities
  arforge debug rg            ripgrep debugging utilities
  arforge debug file          file system debugging utilities
  arforge debug scrap         list all known projects
  arforge debug skill         list all available skills
  arforge debug snapshot      snapshot debugging utilities
  arforge debug startup       print startup timing
  arforge debug agent <name>  show agent configuration details
  arforge debug v2            debug v2 catalog and built-in plugins
  arforge debug info          show debug information
  arforge debug paths         show global paths (data, config, cache, state)
  arforge debug wait          wait indefinitely (for debugging)

选项：
  -h, --help        显示帮助                                                                  [布尔]
  -v, --version     显示版本号                                                                [布尔]
      --print-logs  将日志输出到标准错误                                                      [布尔]
      --log-level   日志级别                    [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        不加载外部插件                                                            [布尔]"
`;

