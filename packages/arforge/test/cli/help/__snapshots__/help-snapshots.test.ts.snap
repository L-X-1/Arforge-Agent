      --text          新增或替换后的提示文本                                                [字符串]
      --agent         仅对该提示生效的代理                                                  [字符串]
      --provider      模型提供商 ID                                                         [字符串]
      --model         模型 ID；与 --provider 一起使用                                       [字符串]
      --variant       模型变体                                                              [字符串]
      --admitted-seq  可选并发令牌；省略时自动读取                                            [数字]
      --workspace     会话所属工作区，默认为当前目录                                        [字符串]
      --json          输出机器可读 JSON                                      [布尔] [默认值： false]"
`;

exports[`arforge CLI help-text snapshots every documented command emits stable help text: arforge workflow --help 1`] = `
"arforge workflow <action> [target] [node-id]

管理验证后的工作流定义与持久化图运行

位置参数：
  action   工作流操作
            [必需] [可选值： "list", "preview", "runs", "get", "start", "pause", "resume", "cancel",
                                                                       "approve", "reject", "retry"]
  target   定义路径或运行 ID                                                                [字符串]
  node-id  审批或重试的节点 ID                                                              [字符串]

选项：
  -h, --help                 显示帮助                                                         [布尔]
  -v, --version              显示版本号                                                       [布尔]
      --print-logs           将日志输出到标准错误                                             [布尔]
      --log-level            日志级别           [字符串] [可选值： "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                 不加载外部插件                                                   [布尔]
      --session              按会话过滤运行，或为新运行指定会话                             [字符串]
      --permission-mode      代理节点权限模式
                             [可选值： "plan", "acceptEdits", "fullAccess"] [默认值： "acceptEdits"]
      --max-parallel         最大并行节点数（1-8）                               [数字] [默认值： 4]
      --comment              审批说明                                                       [字符串]
      --include-descendants  重试节点的后继分支                               [布尔] [默认值： true]
      --workspace            工作区目录，默认为当前目录                                     [字符串]
      --json                 输出机器可读 JSON                               [布尔] [默认值： false]"
`;

